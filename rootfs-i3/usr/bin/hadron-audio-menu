#!/bin/sh
# WirePlumber output switcher for the XLibre/i3 variant, through hadron-pick
# (dmenu here).
list=$(wpctl status 2>/dev/null | awk '
    /Sinks:/      { insink=1; next }
    /Sources:|Filters:|Streams:|^ *$/ { insink=0 }
    insink && match($0, /[0-9]+\./) {
        rest = substr($0, RSTART)
        id = rest; sub(/\..*/, "", id)
        name = rest; sub(/^[0-9]+\.[ ]*/, "", name); sub(/[ ]*\[vol.*$/, "", name)
        active = ($0 ~ /\*/) ? "* " : "  "
        printf "%s%s\t%s\n", active, name, id
    }')

[ -n "$list" ] || exit 0
sel=$(printf '%s\n' "$list" | cut -f1 | hadron-pick 'Audio output' 10) || exit 0
id=$(printf '%s\n' "$list" | awk -F'\t' -v s="$sel" '$1==s{print $2; exit}')
[ -n "$id" ] && wpctl set-default "$id"
