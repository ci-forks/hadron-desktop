# i3 config for Hadron Desktop — Tokyo Night, matching the Sway variant.

set $mod   Mod4
set $term  st
set $menu  hadron-apps
set $left  h
set $down  j
set $up    k
set $right l

# Hadron palette. Generated from theme/palette.toml by tools/gen-theme.py:
# edit the palette, not these values. Inactive titles and workspace labels use
# $dim, not the darker decoration grey, so they stay readable.
set $bg      #1a1b26
set $bg_alt  #24283b
set $fg      #c0caf5
set $blue    #7aa2f7
set $cyan    #7dcfff
set $magenta #bb9af7
set $red     #f7768e
set $dim     #737aa2
set $border  #414868

font pango:Inter Variable 10
default_border pixel 2
default_floating_border pixel 2
title_align center
gaps inner 8
gaps outer 2
smart_gaps on
smart_borders on

# class                 border   bg       text   indicator child_border
client.focused          $blue    $bg      $fg    $cyan     $blue
client.focused_inactive $border  $bg      $dim   $border   $border
client.unfocused        $border  $bg      $dim   $border   $bg
client.urgent           $red     $red     $fg    $red      $red
client.placeholder      $border  $bg      $dim   $border   $border
client.background       $bg

# Shared desktop services. User systemd also socket-activates the audio stack;
# these commands are harmless when it is already running.
# The Hadron wallpaper, scaled to fill each monitor, on the base colour (which
# also shows if the image is missing). exec_always repaints it when i3 restarts,
# e.g. after a monitor is plugged in.
exec_always --no-startup-id hadron-xroot '#1a1b26' /usr/share/backgrounds/hadron/hadron-orbits-night-3840x2160.png
exec --no-startup-id /usr/bin/pipewire
exec --no-startup-id /usr/bin/wireplumber
exec --no-startup-id dunst
exec --no-startup-id $term
# First-login welcome (once per user). It talks to dunst over the session bus
# start-desktop opened. The update icon starts from config.d/30-update-tray.conf.
exec --no-startup-id hadron-welcome
# First-run app picker (a browser and essentials from Flathub), once per user,
# after the network is up. The agent image deletes this line.
exec --no-startup-id hadron-first-run-apps --login
# Night light (xsct), if the user turned it on in an earlier session.
exec --no-startup-id hadron-night-light restore

# help-row: Windows | Super + drag | Move a floating window with the mouse
floating_modifier $mod

# help-section: Basics
# help: Open a terminal
bindsym $mod+Return        exec --no-startup-id $term
# help: Launch an application
bindsym $mod+d             exec --no-startup-id $menu
# The old PATH-only runner, for a command that has no .desktop file.
# help: Run a command that has no app entry
bindsym $mod+Shift+d       exec --no-startup-id dmenu_run -i -l 12 -p "Run" -fn "Inter Variable-11" -nb "#1a1b26" -nf "#c0caf5" -sb "#7aa2f7" -sf "#16161e"
# help: Close the focused window
bindsym $mod+Shift+q       kill
bindsym $mod+Shift+c       reload
# help: Power menu: log out, suspend, reboot, power off
bindsym $mod+Shift+e       exec --no-startup-id hadron-power-menu
# help-section: Basics
# help: This help
bindsym $mod+F1            exec --no-startup-id st -c HadronFloat -t "Keyboard shortcuts" -e hadron-help
# The Hadron menu: apps, Wi-Fi, Bluetooth, audio, capture, update, help, power.
# help: Hadron menu: apps, Wi-Fi, Bluetooth, updates, power
bindsym $mod+Escape        exec --no-startup-id hadron-menu
# Night light on and off: a warmer screen from 20:00 to 07:00.
# help-section: System
# help: Night light on and off
bindsym $mod+Mod1+n        exec --no-startup-id hadron-night-light toggle

# Screen lock. i3lock checks the password through /etc/pam.d/i3lock. xss-lock
# runs the same command on idle and before suspend, from
# config.d/10-screen-lock.conf (variables set here reach included files).
set $lock i3lock --nofork --ignore-empty-password --show-failed-attempts --color=1a1b26
# help-section: System
# help: Lock the screen
bindsym $mod+Mod1+l        exec --no-startup-id $lock

# Screenshots (shotgun + hacksaw + xclip): to the clipboard, like Sway, and to
# ~/Pictures/Screenshots, like niri.
# help-section: System
# help: Screenshot to the clipboard and ~/Pictures
bindsym Print              exec --no-startup-id hadron-screenshot
# help: Screenshot of an area or a window
bindsym $mod+Print         exec --no-startup-id hadron-screenshot area

# help-section: Windows
# help+: Move focus
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# help+: Move the window
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"
# help-section: Workspaces
# help+: Switch to the numbered workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
# help+: Send the window to the numbered workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+b splith
bindsym $mod+v splitv
# help-section: Windows
# help+: Stacked, tabbed or split layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
# help: Fullscreen
bindsym $mod+f fullscreen toggle
# help: Float or tile the window
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym $left  resize shrink width 30 px or 30 ppt
    bindsym $down  resize grow height 30 px or 30 ppt
    bindsym $up    resize shrink height 30 px or 30 ppt
    bindsym $right resize grow width 30 px or 30 ppt
    bindsym Left   resize shrink width 30 px or 30 ppt
    bindsym Down   resize grow height 30 px or 30 ppt
    bindsym Up     resize shrink height 30 px or 30 ppt
    bindsym Right  resize grow width 30 px or 30 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# help: Resize mode (arrows or H J K L, then Enter)
bindsym $mod+r mode "resize"

# Hardware keys: volume (wpctl), screen brightness (logind) and playback
# (MPRIS), with the new level in a dunst pop-up.
bindsym XF86AudioRaiseVolume  exec --no-startup-id hadron-media-key volume-up
bindsym XF86AudioLowerVolume  exec --no-startup-id hadron-media-key volume-down
bindsym XF86AudioMute         exec --no-startup-id hadron-media-key mute
bindsym XF86AudioMicMute      exec --no-startup-id hadron-media-key mic-mute
bindsym XF86MonBrightnessUp   exec --no-startup-id hadron-media-key brightness-up
bindsym XF86MonBrightnessDown exec --no-startup-id hadron-media-key brightness-down
bindsym XF86AudioPlay         exec --no-startup-id hadron-media-key play-pause
bindsym XF86AudioPause        exec --no-startup-id hadron-media-key play-pause
bindsym XF86AudioNext         exec --no-startup-id hadron-media-key next
bindsym XF86AudioPrev         exec --no-startup-id hadron-media-key previous
bindsym XF86AudioStop         exec --no-startup-id hadron-media-key stop

# Wi-Fi, audio output and Bluetooth menus (dmenu).
# help-section: System
# help: Wi-Fi
bindsym $mod+n       exec --no-startup-id hadron-wifi-menu
# help: Audio output
bindsym $mod+Shift+a exec --no-startup-id hadron-audio-menu
# help: Bluetooth
bindsym $mod+Shift+b exec --no-startup-id hadron-bluetooth-menu
for_window [class="HadronFloat"] floating enable, resize set 820 520, move position center
for_window [class="HadronFloat" title="Keyboard shortcuts"] resize set 900 720, move position center

bar {
    position top
    status_command /usr/bin/hadron-status
    tray_output primary
    # 4 px around and between the tray icons (the default is 2): the icons
    # are the bar height less 8 px, close to waybar's 18 px icons, and do not
    # touch each other.
    tray_padding 4
    separator_symbol "  "
    colors {
        background $bg
        statusline $fg
        separator  $border
        focused_workspace  $blue $blue $bg
        active_workspace   $border $bg_alt $fg
        inactive_workspace $border $bg $dim
        urgent_workspace   $red $red $fg
        binding_mode       $magenta $magenta $bg
    }
}

include /etc/i3/config.d/*
