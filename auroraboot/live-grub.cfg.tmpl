# isotope LiveCD GRUB menu — overrides AuroraBoot's hardcoded "Kairos" menu.
#
# AuroraBoot embeds pkg/constants/grub_live_bios.cfg and writes it to the ISO at
# /boot/grub2/grub.cfg — but ONLY if that path does not already exist. We ship our
# own via `--overlay-iso` (auroraboot/build.sh), so AuroraBoot keeps this one and
# the live boot menu reads "isotope" rather than "Kairos". `--override-name`
# only renames the output .iso file, not the menu.
#
# This is a snapshot of upstream grub_live_bios.cfg with these changes:
#   1. menuentry titles "Kairos*" -> "isotope*"
#   2. the Isotope gfxterm theme loaded from the ISO
#   3. the quiet cmdline added to the normal boot paths (recovery/debug kept verbose)
#   4. $isotope_vt_palette on every entry: the console's 16 colours set to the
#      Isotope palette, as the installed menu does (rootfs/etc/kairos/branding/
#      grubmenu.cfg); generated from theme/palette.toml by tools/gen-theme.py
#   5. no `echo Loading kernel...`/`echo Loading initrd...` in the entries: the
#      text box GRUB opens for them covers the theme
#   6. smbios runs only on arm64, where the Thor board is: elsewhere a failed
#      lookup prints an error on the menu
#   7. nomodeset only on "safe graphics", debug and remote recovery, not on
#      every entry as upstream has it
# Keep `CDLABEL=COS_LIVE`, the ($root)/boot/kernel + initrd paths, and the
# {{NOMODESET}}/{{EXTEND_CMDLINE}} placeholders intact. AuroraBoot does NOT expand
# those placeholders for an overlaid file (it only substitutes its own default), so
# build.sh renders them per-arch before handing this to AuroraBoot. Re-sync from
# https://github.com/kairos-io/AuroraBoot/blob/main/pkg/constants/grub_live_bios.cfg
# if upstream changes the entries or live cmdline.
search --file --set=root /boot/kernel
set default=0
set timeout=10
set timeout_style=menu

set font=($root)/boot/${grub_cpu}/loader/grub2/fonts/unicode.pf2
if [ -f ${font} ];then
    loadfont ${font}
fi

# The Isotope theme (gfxterm). We load the theme's own vendored unicode.pf2 (the
# name theme.txt references, "Unifont Regular 16") plus the TGA background, so the
# live and installed menus look identical. The background is TGA because GRUB's
# png.mod rejects valid PNGs with "unsupported format". Best-effort: if video, font
# or theme aren't available GRUB keeps the plain text menu, so a failure here can
# never block boot.
insmod all_video
insmod gfxterm
insmod tga
if [ -f ($root)/boot/grub2/themes/isotope/theme.txt ]; then
    loadfont ($root)/boot/grub2/themes/isotope/unicode.pf2
    set gfxmode=auto
    terminal_output gfxterm
    set theme=($root)/boot/grub2/themes/isotope/theme.txt
fi

set isotope_vt_palette="vt.default_red=0x15,0xf7,0x3f,0xe0,0x8f,0xb4,0xc6,0xcb,0x8f,0xf7,0x3f,0xe0,0x8f,0xb4,0xc6,0xf2 vt.default_grn=0x14,0x76,0xaf,0xaf,0xd1,0x9c,0xf3,0xc8,0x8b,0x76,0xaf,0xaf,0xd1,0x9c,0xf3,0xf1 vt.default_blu=0x1c,0x8e,0x6e,0x68,0x2e,0xf2,0x6b,0xd6,0xa3,0x8e,0x6e,0x68,0x2e,0xf2,0x6b,0xf5"

# Get model. Thor is an arm64 board, and on firmware without the SMBIOS entry
# a failed lookup prints an error on the menu, so ask only on arm64.
set model=""
if [ "${grub_cpu}" = "arm64" ]; then
  smbios --type 4 --get-string 5 --set model
fi
# For Thor we need to set the ignored clk and pd, otherwise devices will die during boot
# The expansion must be quoted: unquoted, an empty model (smbios missing or the
# lookup failing) or a multi-word one (QEMU host CPU strings) splits into
# multiple test arguments and the comparison wrongly evaluates to true,
# leaking $thor_options into the cmdline.
if [ "${model}" = "Thor" ]; then
  echo "Thor device detected, setting ignored clocks and power domains and proper console output"
  set thor_options="pd_ignore_unused clk_ignore_unused console=ttyUTC0,115200 earlycon=tegra_utc,mmio32,0xc5a0000"
  export thor_options
fi

# {{NOMODESET}} is " nomodeset" on x86/amd64 and empty elsewhere; build.sh
# renders it and {{EXTEND_CMDLINE}}. The normal entries leave it out, so the
# AMD, Intel and NVIDIA drivers load with their firmware on the live system.
# "safe graphics", debug and remote recovery keep it, for machines whose
# graphics driver hangs or shows nothing: they stay on the firmware
# framebuffer.
menuentry "isotope" --class os --unrestricted {
    linux ($root)/boot/kernel cdroot root=live:CDLABEL=COS_LIVE rd.live.dir=/ rd.live.squashimg=rootfs.squashfs net.ifnames=1 console=ttyS0 console=tty1 rd.cos.disable vga=795 install-mode selinux=0 $thor_options rd.live.overlay.overlayfs quiet splash loglevel=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false $isotope_vt_palette{{EXTEND_CMDLINE}}
    initrd ($root)/boot/initrd
}

menuentry "isotope (safe graphics)" --class os --unrestricted {
    linux ($root)/boot/kernel cdroot root=live:CDLABEL=COS_LIVE rd.live.dir=/ rd.live.squashimg=rootfs.squashfs net.ifnames=1 console=ttyS0 console=tty1 rd.cos.disable vga=795{{NOMODESET}} install-mode selinux=0 $thor_options rd.live.overlay.overlayfs quiet splash loglevel=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false $isotope_vt_palette{{EXTEND_CMDLINE}}
    initrd ($root)/boot/initrd
}

menuentry "isotope (manual)" --class os --unrestricted {
    linux ($root)/boot/kernel cdroot root=live:CDLABEL=COS_LIVE rd.live.dir=/ rd.live.squashimg=rootfs.squashfs net.ifnames=1 console=ttyS0 console=tty1 rd.cos.disable vga=795 selinux=0 $thor_options rd.live.overlay.overlayfs quiet splash loglevel=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false $isotope_vt_palette{{EXTEND_CMDLINE}}
    initrd ($root)/boot/initrd
}

menuentry "isotope (interactive install)" --class os --unrestricted {
    linux ($root)/boot/kernel cdroot root=live:CDLABEL=COS_LIVE rd.live.dir=/ rd.live.squashimg=rootfs.squashfs net.ifnames=1 console=ttyS0 console=tty1 rd.cos.disable vga=795 install-mode-interactive selinux=0 $thor_options rd.live.overlay.overlayfs quiet splash loglevel=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false $isotope_vt_palette{{EXTEND_CMDLINE}}
    initrd ($root)/boot/initrd
}

menuentry "isotope (remote recovery mode)" --class os --unrestricted {
    linux ($root)/boot/kernel cdroot root=live:CDLABEL=COS_LIVE rd.live.dir=/ rd.live.squashimg=rootfs.squashfs net.ifnames=1 console=ttyS0 console=tty1 rd.cos.disable vga=795{{NOMODESET}} kairos.remote_recovery_mode selinux=0 $thor_options rd.live.overlay.overlayfs $isotope_vt_palette{{EXTEND_CMDLINE}}
    initrd ($root)/boot/initrd
}

menuentry "isotope (boot local node from livecd)" --class os --unrestricted {
    linux ($root)/boot/kernel cdroot root=live:CDLABEL=COS_LIVE rd.live.dir=/ rd.live.squashimg=rootfs.squashfs net.ifnames=1 console=ttyS0 console=tty1 kairos.boot_live_mode vga=795 selinux=0 $thor_options rd.live.overlay.overlayfs quiet splash loglevel=3 udev.log_level=3 systemd.show_status=false rd.systemd.show_status=false $isotope_vt_palette{{EXTEND_CMDLINE}}
    initrd ($root)/boot/initrd
}

menuentry "isotope (debug)" --class os --unrestricted {
    linux ($root)/boot/kernel cdroot root=live:CDLABEL=COS_LIVE rd.live.dir=/ rd.live.squashimg=rootfs.squashfs net.ifnames=1 console=tty0 rd.debug rd.shell rd.cos.disable rd.immucore.debug vga=795{{NOMODESET}} selinux=0 $thor_options rd.live.overlay.overlayfs $isotope_vt_palette{{EXTEND_CMDLINE}}
    initrd ($root)/boot/initrd
}

if [ "${grub_platform}" = "efi" ]; then
    menuentry "Text mode" --hotkey "t" {
        set textmode=true
        terminal_output console
    }
fi
