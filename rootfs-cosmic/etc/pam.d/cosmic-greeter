#%PAM-1.0
# The user's session, started by greetd after cosmic-greeter authenticates them.
# Same stack as ly's: Hadron's `login` service, plus a logind session of class
# user so the desktop gets a seat, a runtime dir and the user's systemd.
auth       include      login
-auth      optional     pam_gnome_keyring.so

account    include      login

password   include      login
-password  optional     pam_gnome_keyring.so use_authtok

-session   optional     pam_systemd.so       class=user
session    include      login
-session   optional     pam_gnome_keyring.so auto_start
