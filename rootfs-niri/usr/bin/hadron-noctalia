#!/bin/sh
# Start the Noctalia shell with Hadron Desktop's defaults. Noctalia has no
# system-wide config, so the defaults are refreshed into the user's config
# directory as one file that sorts before any config the user writes.
d="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
mkdir -p "$d" && cp /usr/share/hadron-desktop/noctalia-defaults.toml "$d/00-hadron-defaults.toml"
exec noctalia "$@"
