# Isotope agent public HTTPS MCP gateway.
#
# This is the ONLY internet-facing agent process, so it is the most tightly
# sandboxed one: it runs as the locked, no-login `isotope-agent-gateway` system
# account with no supplementary groups, no capabilities at all, no ability to
# gain privilege, a read-only view of the whole filesystem, and write access to
# nothing but its two runtime socket directories. Everything it needs to serve
# (TLS material + bearer digests in config.json) is provisioned into the
# read-only state dir by isotope-agent-provision.service first.
[Unit]
Description=Isotope agent public HTTPS MCP gateway
ConditionPathExists=/etc/isotope-agent/profile
Requires=isotope-agent-provision.service
After=isotope-agent-provision.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isotope-agent-gateway
Group=isotope-agent-gateway
# No supplementary (privileged) groups: only the primary gateway group.
SupplementaryGroups=
# Drop every capability; the gateway needs none.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
# Read-only view of the entire filesystem hierarchy...
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# ...with write access ONLY to its runtime status + control socket dirs, and a
# read-only view of the provisioned state dir it loads config/TLS from.
# ProtectSystem=strict leaves /var visible; ReadOnlyPaths pins the state dir
# read-only. The gateway process runs as the isotope-agent-gateway user, which is
# the group that owns config.json/tls.crt/tls.key (0440, group-readable), so it
# can READ everything it needs under /var/lib/isotope-agent/gateway/ and write
# nowhere in /var.
ReadWritePaths=/run/isotope-agent/status /run/isotope-agent/control
ReadOnlyPaths=/var/lib/isotope-agent
# The gateway derives its listen address, TLS cert/key paths, bearer digests
# (with rotation), and limits entirely from the provisioned config.json.
ExecStart=/usr/bin/isotope-agent gateway --config /var/lib/isotope-agent/gateway/config.json
# SIGHUP triggers a parse-then-atomically-swap config reload in the gateway.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30s

[Install]
WantedBy=multi-user.target
