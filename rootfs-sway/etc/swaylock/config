# swaylock for Isotope: the Isotope palette, matching the Sway theme.
# Colours: generated from theme/palette.toml by tools/gen-theme.py.
# A user's ~/.config/swaylock/config replaces this file.
# The plain Isotope background, scaled to fill; `color` shows if it is missing.
image=/usr/share/backgrounds/isotope/isotope-plain-night-1920x1080.png
scaling=fill
color=15141c
font=Inter Variable
indicator-radius=90
indicator-thickness=8
show-failed-attempts
ignore-empty-password

inside-color=15141c
inside-clear-color=15141c
inside-caps-lock-color=15141c
inside-ver-color=15141c
inside-wrong-color=15141c

ring-color=3c3a49
ring-clear-color=c6f36b
ring-caps-lock-color=e0af68
ring-ver-color=8fd12e
ring-wrong-color=f7768e

key-hl-color=8fd12e
bs-hl-color=f7768e
caps-lock-key-hl-color=e0af68
caps-lock-bs-hl-color=f7768e

line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

text-color=f2f1f5
text-clear-color=c6f36b
text-caps-lock-color=e0af68
text-ver-color=8fd12e
text-wrong-color=f7768e
layout-text-color=f2f1f5
layout-bg-color=15141c
layout-border-color=00000000
