#!/bin/sh
# Power menu for Sway, bound to Mod+Shift+e and the waybar power button. The
# picker is hadron-pick, so it looks like the Hadron menu (the icons show in
# fuzzel only).
# logind allows suspend, restart and power off to the user of the active local
# session through polkit, so any user can use them, not only `admin`. If polkit
# refuses (another user is logged in too, say), an admin's passwordless sudo
# (Kairos' 10_accounting stage) is tried; -n never prompts.
# power ACTION: systemctl through polkit, else through sudo.
power() { systemctl "$1" 2>/dev/null || sudo -n /usr/bin/systemctl "$1"; }

sel=$(printf '%s\t%s\n' Lock 󰌾 "Log out" 󰍃 Suspend 󰒲 Restart 󰜉 "Power off" 󰐥 |
    hadron-pick Power 5) || exit 0
case "$sel" in
    Lock)        swaylock -f ;;
    "Log out")   swaymsg exit ;;
    Suspend)     power suspend ;;
    Restart)     power reboot ;;
    "Power off") power poweroff ;;
esac
